{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["@cloudflare/workers-types", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test", "apps/*/cloudflare.config.ts", "apps/*/vite.config.ts", "examples/*/src", "examples/*/test", "examples/*/cloudflare.config.ts", "examples/*/vite.config.ts", "contract/test", "test", "*.config.ts"]
}
